# ==============================================================================
# Forex & Commodity Observation Terminal - Market Data API Configuration
# ==============================================================================
# Configure the API keys for the 4 supported market data providers.
# Supported Assets: ONLY Gold (XAU/USD) and Bitcoin (BTC/USD).
# ==============================================================================

# 1. Twelve Data (Primary Provider - Gold & BTC Live Quotes, WebSocket & Candles)
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# 2. Finnhub (Backup Provider - BTC Live Quotes & Market Data)
FINNHUB_API_KEY=your_finnhub_api_key_here

# 3. Alpha Vantage (Historical & Backup Provider)
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# 4. EODHD (Historical EOD & BTC Real-Time Data)
EODHD_API_KEY=your_eodhd_api_key_here
